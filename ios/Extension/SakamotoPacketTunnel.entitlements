<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Real declarations, placeholder identifiers (ios/README.md). The
	     packet-tunnel-provider entitlement is what the system requires to
	     load this process as a PacketTunnelProvider; it cannot be stubbed. -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.pidal.sakamoto</string>
	</array>
</dict>
</plist>
