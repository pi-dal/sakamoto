<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Real declarations, placeholder identifiers. Apple provisions the
	     NetworkExtension entitlement only for a real Team; see ios/README.md.
	     No stub keys are present by design. -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.pidal.sakamoto</string>
	</array>
	<!-- iCloud Documents (ubiquity container) for the source-sync feature
	     (Settings → Sync sources to iCloud). The container id is a PLACEHOLDER
	     matching UbiquityICloudContainer.placeholderContainerID and the
	     NSUbiquitousContainers entry in project.yml — replace all three
	     together with a real Team. The PacketTunnel target deliberately has
	     NO iCloud entitlements: sync is an app-process feature. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.pidal.sakamoto</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
</dict>
</plist>
