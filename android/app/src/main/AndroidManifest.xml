<?xml version="1.0" encoding="utf-8"?>
<!-- sakamoto Android manifest.

     Permission set follows the upstream SagerNet/sing-box-for-android
     manifest for the pieces this client actually implements: INTERNET,
     the foreground-service pair for the VPN service, POST_NOTIFICATIONS
     for the libbox service notification, and the BIND_VPN_SERVICE-
     protected service declaration with the android.net.VpnService intent
     filter. The Wi-Fi/location permissions of upstream (WIFI state for
     rule matching) are intentionally omitted until the matching feature
     is wired; adding them early would request more than we use. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+ requires a declared foreground service type; the VPN service
         uses systemExempted like upstream's VPNService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SakamotoApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sakamoto"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".bg.SakamotoVpnService"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE"
            tools:ignore="ForegroundServicePermission">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

    </application>

</manifest>
