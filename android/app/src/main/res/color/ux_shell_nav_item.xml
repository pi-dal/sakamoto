<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom tab tint: selected tabs carry the primary colour, everything else
     the muted surface tone; disabled items fade like Material defaults. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/on_surface_variant" android:alpha="0.38" android:state_enabled="false" />
    <item android:color="@color/primary" android:state_checked="true" />
    <item android:color="@color/on_surface_variant" />
</selector>
