    <!-- About page. -->
    <string name="about_version">sakamoto %1$s</string>
    <string name="about_license">This app is free software: licensed under the GNU General Public License v3.0. There is NO WARRANTY, to the extent permitted by law.</string>
    <string name="about_singbox">Powered by sing-box — the universal proxy platform by SagerNet (github.com/SagerNet/sing-box), used here through its libbox mobile library (v1.14.2, built with with_tailscale). sing-box is GPL-3.0; this app embeds it as the tunnel core.</string>
    <string name="about_tailscale">Tailscale integration is the sing-box built-in Tailscale endpoint (embedded tsnet client). It is independent open-source code; not affiliated with, endorsed by, or connected to Tailscale, Inc.</string>
    <string name="about_unofficial">This is an unofficial client built for personal use. State vocabulary, phase folding and routing semantics are shared with the sakamoto host via pkg/mobilecore.</string>
    <string name="about_state_semantics">Home/Config/Data/Settings semantics mirror the sakamoto macOS TUI: phases fold in Go, this app renders.</string>
