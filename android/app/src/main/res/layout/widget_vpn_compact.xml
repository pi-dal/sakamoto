<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews only supports framework widgets; native tint is required. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:paddingHorizontal="8dp" android:paddingVertical="0dp" android:background="@drawable/bg_widget">
    <LinearLayout android:id="@+id/widget_compact_content" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center">
        <LinearLayout android:id="@+id/widget_compact_header" android:layout_width="match_parent" android:layout_height="48dp"
            android:orientation="horizontal" android:gravity="center">
            <ImageButton android:id="@+id/widget_toggle" android:layout_width="48dp" android:layout_height="48dp"
                android:src="@drawable/ic_service" android:tint="@color/primary" android:padding="12dp"
                android:contentDescription="@string/connect" android:background="@drawable/bg_widget_control" />
            <LinearLayout android:id="@+id/widget_compact_measurement" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="center">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center">
                    <ImageView android:id="@+id/widget_state_dot" android:layout_width="6dp" android:layout_height="6dp"
                        android:src="@drawable/widget_dot" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" android:text="@string/widget_off" android:textSize="11sp" android:textStyle="bold"
                        android:textColor="@color/on_surface" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
                <TextView android:id="@+id/widget_latency" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text="@string/widget_latency_empty" android:textSize="12sp"
                    android:gravity="center" android:textStyle="bold" android:fontFeatureSettings="tnum" android:textColor="@color/primary" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="11sp" android:textColor="@color/on_surface_variant"
            android:gravity="center" android:layout_marginTop="6dp" android:maxLines="1" android:ellipsize="middle" />
        <TextView android:id="@+id/widget_node_info" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:layout_marginTop="2dp" android:textSize="9sp"
            android:textColor="@color/on_surface_variant" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
