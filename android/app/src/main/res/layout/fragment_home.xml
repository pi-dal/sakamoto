<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/phase_value"
            style="?attr/textAppearanceHeadlineMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            tools:text="Disconnected" />

        <TextView
            android:id="@+id/service_state_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            tools:text="Stopped" />

        <TextView
            android:id="@+id/probe_state_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            tools:text="Idle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/connect_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/connect" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/disconnect_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/disconnect" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp" />

        <TextView
            android:id="@+id/mode_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mode_label" />

        <TextView
            android:id="@+id/mode_value"
            style="?attr/textAppearanceTitleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Rule" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cycle_mode_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cycle_mode" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp" />

        <TextView
            android:id="@+id/selected_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/selected_label" />

        <TextView
            android:id="@+id/selected_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="—" />

        <TextView
            android:id="@+id/selected_reachability"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Untested" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/url_test_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/url_test" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp" />

        <TextView
            android:id="@+id/config_state_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_state_label" />

        <TextView
            android:id="@+id/config_state_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Clean" />

        <TextView
            android:id="@+id/notice_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
