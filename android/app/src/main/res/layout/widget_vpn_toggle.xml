<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews only supports framework widgets; native tint is required. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="4dp" android:background="@drawable/bg_widget">
    <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
        <ImageButton android:id="@+id/widget_toggle" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_service" android:tint="@color/primary" android:padding="12dp"
            android:contentDescription="@string/connect" android:background="?android:attr/selectableItemBackgroundBorderless" />
        <ImageView android:id="@+id/widget_state_dot" android:layout_width="6dp" android:layout_height="6dp"
            android:layout_gravity="top|end" android:layout_margin="3dp" android:src="@drawable/widget_dot" android:importantForAccessibility="no" />
    </FrameLayout>
    <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/widget_off" android:textSize="10sp" android:textColor="@color/on_surface"
        android:gravity="center" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
