<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/bg_widget">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_state_dot" android:layout_width="8dp" android:layout_height="8dp"
            android:src="@drawable/widget_dot" android:tint="@color/on_surface_variant" android:importantForAccessibility="no" />
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:text="@string/widget_off" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/on_surface" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_mode" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="@color/on_surface_variant" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widget_latency" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_latency_empty" android:textSize="18sp" android:textStyle="bold" android:fontFeatureSettings="tnum"
                android:textColor="@color/primary" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_latency_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_node_latency" android:textSize="11sp" android:textColor="@color/on_surface_variant"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageButton android:id="@+id/widget_toggle" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_service" android:tint="@color/primary" android:padding="12dp"
            android:contentDescription="@string/connect" android:background="@drawable/bg_widget_control" />
        <ImageButton android:id="@+id/widget_check" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginStart="8dp" android:src="@drawable/ic_refresh" android:tint="@color/on_surface_variant" android:padding="12dp"
            android:contentDescription="@string/vpn_check_now" android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
    <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="@color/on_surface" android:maxLines="1" android:ellipsize="middle" />
    <TextView android:id="@+id/widget_node_info" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textSize="10sp" android:textColor="@color/on_surface_variant"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_experiment" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:textSize="10sp" android:textColor="@color/on_surface_variant" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
