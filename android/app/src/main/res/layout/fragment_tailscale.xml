<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/backend_state"
            style="?attr/textAppearanceHeadlineSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Stopped"
            xmlns:tools="http://schemas.android.com/tools" />

        <TextView style="@style/Text.Sakamoto.Body"
            android:id="@+id/tailnet_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView style="@style/Text.Sakamoto.Body"
            android:id="@+id/exit_node_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Sakamoto.SecondaryButton"
            android:id="@+id/open_auth_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:text="@string/ts_open_auth_url" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp" />

        <!-- Auth key: Keystore-encrypted, app-private; masked display only. -->
        <TextView
            style="@style/Text.Sakamoto.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ts_authkey_title" />

        <TextView style="@style/Text.Sakamoto.Body"
            android:id="@+id/authkey_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/authkey_store"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ts_authkey_store" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/authkey_delete"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ts_authkey_delete" />
        </LinearLayout>

        <TextView style="@style/Text.Sakamoto.Supporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ts_authkey_note" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp" />

        <!-- Exit node candidates: built programmatically (small lists). -->
        <TextView
            style="@style/Text.Sakamoto.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ts_exit_candidates" />

        <LinearLayout
            android:id="@+id/exit_candidates_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clear_exit_node"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ts_clear_exit" />

        <TextView
            style="@style/Text.Sakamoto.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ts_peers" />

        <TextView style="@style/Text.Sakamoto.Body"
            android:id="@+id/peers_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textIsSelectable="true" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Sakamoto.SecondaryButton"
            android:id="@+id/ping_exit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ts_ping_exit" />

        <TextView style="@style/Text.Sakamoto.Body"
            android:id="@+id/ping_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textIsSelectable="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ts_logout" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp" />

        <!-- Unsupported capabilities, rendered verbatim from the model. -->
        <TextView
            style="@style/Text.Sakamoto.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ts_unsupported_title" />

        <TextView style="@style/Text.Sakamoto.Body"
            android:id="@+id/unsupported_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView style="@style/Text.Sakamoto.Body"
            android:id="@+id/ts_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
