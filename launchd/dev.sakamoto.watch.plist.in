<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>Label</key><string>dev.sakamoto.watch</string>
    <key>ProgramArguments</key><array><string>@BIN@</string><string>watch</string></array>
    <key>EnvironmentVariables</key><dict><key>SAKAMOTO_DIR</key><string>@DIR@</string><key>SAKAMOTO_SING_BOX</key><string>@SING_BOX@</string><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>5</integer>
    <key>StandardOutPath</key><string>@DIR@/logs/watch.out.log</string>
    <key>StandardErrorPath</key><string>@DIR@/logs/watch.err.log</string>
</dict></plist>
